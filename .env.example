# Copy to .env only for local owner testing; never commit real credentials.
#
# Public production origin, without a path, query or trailing slash.
# Required by `npm run build:release`; omitted by `npm run build` for a noindex
# local preview. Example shape only — do not guess the project domain.
# SITE_URL=https://www.example.org
#
# A monitored address that can receive corrections. Optional: when empty, the
# About page states that the correction channel is not open. This value is
# public in the client bundle, so use a project address, never a private one.
# CORRECTION_EMAIL=corrections@example.org
