{
  "name": "mesozo",
  "version": "1.0.0",
  "description": "MESOZO — a digital natural-history exhibition of dinosaurs, fossil evidence and reconstruction.",
  "scripts": {
    "predev": "node scripts/generate-search-trails.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-search-trails.mjs",
    "build": "tsc --noEmit && vite build && node scripts/generate-seo.mjs && node scripts/prune-dist.mjs",
    "build:release": "node scripts/build-release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/optimize-assets.mjs",
    "credits": "node scripts/build-credits.mjs",
    "audit:species": "node scripts/audit-species.mjs",
    "data:check": "node scripts/validate-data.mjs && node scripts/validate-journal.mjs && node scripts/validate-crosslinks.mjs",
    "data:journal": "node scripts/validate-journal.mjs",
    "data:update": "node scripts/update-sources.mjs"
  },
  "keywords": [],
  "author": "Abhinav Aagiri",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
